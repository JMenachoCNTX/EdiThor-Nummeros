rules_version = '2';

// Reglas de Firestore para EdiThor Nummeros.
// Solo las cuentas de Google de esta lista pueden ver y guardar diseños e imágenes.
// Para dar acceso a otra persona, agrega su correo a la lista y vuelve a publicar las reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jhonnymenacho04@gmail.com',
          'info@contaxbolivia.com',
          'sol@contaxbolivia.com',
          'contaxcontabilidad5@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
